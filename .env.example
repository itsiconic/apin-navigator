# ============================================
# APIN — Academic Project & Internship Navigator
# Environment Configuration
# ============================================

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME="APIN — Academic Project & Internship Navigator"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/career_intelligence?schema=public"

# Authentication
JWT_SECRET="change-this-to-a-strong-random-secret-in-production"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="change-this-to-another-strong-random-secret"

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Email Provider (resend | smtp | mock)
EMAIL_PROVIDER=mock
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="noreply@apin.dev"

# SMS Provider (twilio | mock)
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AI Provider (openai | gemini | anthropic | mock)
AI_PROVIDER=mock
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=gpt-4o-mini
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_MS=30000

# File Storage (s3 | local)
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# Redis (for background jobs)
REDIS_URL="redis://localhost:6379"

# GitHub Integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-publishable-key"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Admin
ADMIN_DEFAULT_EMAIL=admin@apin.dev
ADMIN_DEFAULT_PASSWORD=change-this-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
